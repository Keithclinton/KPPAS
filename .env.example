# Copy this file to .env for local overrides (optional -- sensible defaults
# apply without one). In a real deployment (Railway, etc.), set these as
# actual environment variables in the platform's dashboard instead of a file.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Must be False in any real deployment.
DJANGO_DEBUG=True

# Comma-separated, e.g. your-app.up.railway.app,yourdomain.com
DJANGO_ALLOWED_HOSTS=

# Comma-separated, must include the scheme, e.g. https://your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set automatically by Railway's Postgres plugin -- leave blank locally to
# use SQLite instead.
DATABASE_URL=
